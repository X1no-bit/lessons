from sklearn.preprocessing import MinMaxScaler, StandardScaler # Нормализаторы
min_max_scaler = MinMaxScaler()
standard_scaler = StandardScaler()
min_max_df = min_max_scaler.fit_transform(train_df.to_numpy())  #Нормализуем по MinMax, продворительно представив в виде numpy
min_max_df = pd.DataFrame(min_max_df, columns = train_df.columns) #Возвращаем к DataFrame
stand_df = standard_scaler.fit_transform(train_df.to_numpy()) #Нормализуем по Standard, продворительно представив в виде numpy
stand_df = pd.DataFrame(stand_df, columns = train_df.columns) #Возвращаем к DataFrame
# Выводим Гистограммы
plt.hist(min_max_df.price_doc, alpha=0.5, label = "MinMax")
plt.hist(stand_df.price_doc, alpha=0.5, label = "Standard")
plt.xlabel("Значение")
plt.ylabel("Количество")
