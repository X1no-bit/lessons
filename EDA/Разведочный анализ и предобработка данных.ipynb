Удаляем выбросы методом межквартильного дипазона
import numpy as np # Библиотека для линейно алгебры
for col in train_df.columns:
    Q3 = np.quantile(train_df[col], 0.75) # Методо quantile возвращет соответствующий квантиль набора данных
    Q1 = np.quantile(train_df[col], 0.25)
    IQR = Q3 - Q1 # Размах
    lower_range = Q1 - 1.5 * IQR #Нижний ус
    upper_range = Q3 + 1.5 * IQR #Верхний ус
    train_df = train_df[(train_df[col] >= lower_range) & (train_df[col] <= upper_range)] #Удаляем значения за пределами усов

